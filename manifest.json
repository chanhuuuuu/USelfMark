{
  "manifest_version": 3,
  "name": "USelfMark",
  "version": "1.0",
  "description": "USelfMark｜本地Ollama多模态网页剪藏，图文智能归档Notion",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://api.notion.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
